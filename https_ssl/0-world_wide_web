#!/usr/bin/env bash
# Displays information about the subdomains of a domain
# shellcheck disable=SC2086

domain=$1
subdomain=$2

display_subdomain() {
    local sub=$1
    local record_type destination

    record_type=$(dig "${sub}.${domain}" | awk '/ANSWER SECTION:/ {getline; print $4}')
    destination=$(dig "${sub}.${domain}" | awk '/ANSWER SECTION:/ {getline; print $5}')

    echo "The subdomain ${sub} is a ${record_type} record and points to ${destination}"
}

if [ -n "$subdomain" ]; then
    display_subdomain "$subdomain"
else
    for sub in www lb-01 web-01 web-02; do
        display_subdomain "$sub"
    done
fi
